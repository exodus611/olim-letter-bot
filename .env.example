# Скопируй в .env и заполни

# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Ключ Gemini API — бесплатно на https://aistudio.google.com/apikey (карта не нужна)
GEMINI_API_KEY=AIza...

# Flash-модели работают на бесплатном тарифе
GEMINI_MODEL=gemini-2.5-flash

# Твой Telegram user_id (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789

# Необязательно: юзернейм бота без @ (иначе определится автоматически)
BOT_USERNAME=

# Необязательно: id Telegram-группы, куда падают лиды для партнёров (адвокаты и т.д.)
LEAD_CHAT_ID=
